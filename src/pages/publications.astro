---
import { getCollection, getEntry } from 'astro:content'
import Base from '../layouts/Base.astro'
import PubEntry from '../components/PubEntry.astro'
import { groupByKind } from '../lib/publications'

const profileEntry = await getEntry('profile', 'profile')
if (!profileEntry) throw new Error('src/data/profile.yaml could not be loaded')
const profile = profileEntry.data

const sections = groupByKind(await getCollection('publications'))

// The note below points at whichever scholarly profiles are configured in
// profile.yaml, so filling in the commented-out Google Scholar entry there is
// enough to have it appear here too.
const profiles = profile.links.filter((link) =>
  /orcid|scholar/i.test(link.label),
)
---

<Base
  title="Publications"
  description={`Publications, talks and posters by ${profile.name}.`}
>
  <h1>Publications</h1>

  {
    profiles.length > 0 && (
      <p class="note muted">
        This list is maintained by hand; please refer to my{' '}
        {profiles.map((link, index) => (
          <>
            {index > 0 && (index === profiles.length - 1 ? ' or ' : ', ')}
            <a href={link.url}>{link.label}</a>
          </>
        ))}{' '}
        {profiles.length > 1 ? 'profiles' : 'profile'} for the most accurate and
        up-to-date record.
      </p>
    )
  }

  {
    sections.map((section) => (
      <>
        <h2>{section.heading}</h2>
        <ul class="plain-list">
          {section.entries.map((entry) => (
            <PubEntry entry={entry} aliases={profile.nameAliases} />
          ))}
        </ul>
      </>
    ))
  }
</Base>

<style>
  .note {
    font-size: var(--text-sm);
    margin-bottom: 0;
  }
</style>
