---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { formatDate } from '../../lib/format'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)
---

<Base title="Blog" description="Notes on quantum programming languages and more.">
  <h1>Blog</h1>

  {
    posts.length === 0 ? (
      <p class="muted">No posts yet.</p>
    ) : (
      <ul class="plain-list posts">
        {posts.map((post) => (
          <li>
            <time class="mono date" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <div>
              <a class="title" href={`/blog/${post.id}/`}>
                {post.data.title}
              </a>
              {post.data.description && (
                <p class="muted excerpt">{post.data.description}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .posts li {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0 1rem;
    margin-bottom: 1.4rem;
  }

  @media (max-width: 32rem) {
    .posts li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  .date {
    font-size: 0.8rem;
    color: var(--color-faint);
    padding-top: 0.25rem;
    white-space: nowrap;
  }

  .title {
    font-weight: 560;
    text-decoration: none;
  }

  .title:hover,
  .title:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .excerpt {
    font-size: 0.9rem;
    margin: 0.15rem 0 0;
  }
</style>
